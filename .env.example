# Google service account JSON file path for local runs.
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json

# Search Console verified property URL or sc-domain:example.com
GSC_SITE_URL=https://indetail-design.com/

# Numeric GA4 property ID (not the Measurement ID)
GA4_PROPERTY_ID=

# Google Maps Platform Places API (New) key. Optional; billing may apply.
GOOGLE_MAPS_API_KEY=

# Optional Meta / Instagram Graph API credentials
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v23.0
